[Unit]
Description=Back up Engram off-site (restic to Google Drive)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/engram
Environment=ENGRAM_ENV_FILE=/etc/engram/engram.env
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/opt/engram/deploy/backup.sh
