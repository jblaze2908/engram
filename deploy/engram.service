[Unit]
Description=Verify and deploy Engram
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/engram
Environment=DEPLOY_DIR=/opt/engram
Environment=DEPLOY_BRANCH=main
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/opt/engram/deploy/pull-update.sh
