# Engram instance config. With deploy/compose.yml, put the first block in /etc/engram/hosts.env (public, read by
# both containers) and the rest in /etc/engram/engram.env (root-only, app container only).

# --- hosts.env ---
ENGRAM_HOST=engram.example.com              # public hostname of the app (OAuth issuer, MCP origin checks, links)
ENGRAM_ARTIFACTS_HOST=artifacts.example.com # separate origin for published files; default artifacts.<ENGRAM_HOST>
ENGRAM_OWNER_NAME=                          # your name on /privacy (needed for Google OAuth verification)

# --- engram.env ---
# ENGRAM_PUBLIC_URL=https://engram.example.com   # only if it differs from https://<ENGRAM_HOST>
# ENGRAM_VAULT_REMOTE=git@github.com:you/engram-vault.git   # optional: mirror the vault to a private git repo
# ENGRAM_NTFY_URL=https://ntfy.example.com/engram           # optional: phone notifications (see deploy/ntfy)
# ENGRAM_NTFY_TOKEN=
# RESTIC_REPOSITORY=rclone:remote:engram-backup             # used by deploy/backup.sh

# --- local development ---
# ENGRAM_ROOT=./.data     # vault, SQLite index, master key
# PORT=8340
